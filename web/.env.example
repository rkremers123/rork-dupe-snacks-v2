# Copy to .env and fill in. In production these are set in the Vercel dashboard.

# Production: your Vercel Postgres connection string (Vercel injects this
# automatically when you attach a Postgres database to the project).
# Local dev: either point this at a Postgres database, or temporarily switch
# the datasource provider in prisma/schema.prisma to "sqlite" and use:
#   DATABASE_URL="file:./dev.db"
DATABASE_URL="postgres://user:password@host:5432/dupesnacks?sslmode=require"

# Your Amazon Associates tracking tag.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG="dupesnacks-20"

# Password for the /admin dashboard.
ADMIN_PASSWORD="set-a-strong-password"
# Random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET="set-a-long-random-string"
